# 이 파일을 .env.local 로 복사하세요.
# (운영 시 VITE_TYPESENSE_SEARCH_KEY 는 documents:search 권한만 가진 scoped key 로)
#
# 운영 검색 호스트는 엣지 캐시 워커를 쓴다(반복검색 가속 + 드롭릿 부하↓):
#   VITE_TYPESENSE_HOST=law-search-cache.zihado.workers.dev
# 워커가 api-law.zihado.com(Typesense@DO)로 프록시한다. 캐시 없이 직결하려면
# VITE_TYPESENSE_HOST=api-law.zihado.com 로 두면 된다.
VITE_TYPESENSE_HOST=localhost
VITE_TYPESENSE_PORT=8108
VITE_TYPESENSE_PROTOCOL=http
VITE_TYPESENSE_SEARCH_KEY=legalize_dev_key
VITE_TYPESENSE_COLLECTION=kr_laws
