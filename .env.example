# Typesense 설정. 이 파일을 .env 로 복사한 뒤 키를 바꾸세요.
#   cp .env.example .env

# 관리(쓰기) 키 — 인덱서가 사용. 외부 노출 금지.
TYPESENSE_API_KEY=legalize_dev_key

# 검색 전용(읽기) 키 — 웹 UI에 박힘. 운영 시에는
# Typesense API로 documents:search 권한만 가진 scoped key를 발급해 쓰세요.
TYPESENSE_SEARCH_ONLY_KEY=legalize_dev_key

# Typesense 접속 정보
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

# 인덱싱 대상 법령 루트 (이 저장소의 kr/ 디렉터리)
LAW_ROOT=../kr

# 컬렉션 이름
TYPESENSE_COLLECTION=kr_laws

# 행정규칙 수집기 (collector)
LAW_GO_KR_OC=lawmcp123
ADMRULE_ROOT=../kr
COLLECT_CONCURRENCY=6
COLLECT_RETRY=3

# 판례 수집/색인
PREC_ROOT=../prec
PREC_COLLECTION=kr_precedents
